{
  "cache": { "enabled": false },
  "query_rewrite": { "enabled": false },
  "reranking": {
    "enabled": true,
    "model": "@cf/baai/bge-reranker-base",
    "match_threshold": 0.5
  },
  "retrieval": {
    "retrieval_type": "keyword",
    "keyword_match_mode": "or",
    "max_num_results": 5,
    "return_on_failure": false
  }
}
