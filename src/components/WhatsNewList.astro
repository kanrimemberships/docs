---
import { getCollection } from "astro:content";

const entries = (await getCollection("docs"))
  .filter((entry) => entry.id.startsWith("whats-new/"))
  .filter((entry) => entry.id !== "whats-new/index" && !entry.data.draft)
  .sort((a, b) => {
    const aDate = a.id.match(/^whats-new\/(\d{4}-\d{2}-\d{2})/i)?.[1];
    const bDate = b.id.match(/^whats-new\/(\d{4}-\d{2}-\d{2})/i)?.[1];
    if (aDate && bDate) return bDate.localeCompare(aDate);
    if (aDate) return -1;
    if (bDate) return 1;
    return b.id.localeCompare(a.id);
  });
---

<ul>
  {entries.map((entry) => (
    <li>
      <a href={`/${entry.id}/`}>{entry.data.title}</a>
      <span>: {entry.data.description}</span>
    </li>
  ))}
</ul>
